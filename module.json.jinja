{
	"id": "[[ module_id ]]",
	"title": "[[ module_title ]]",
	"description": "[[ module_description ]]",
	"version": "0.0.0",
	"compatibility": {
		"minimum": "[[ foundry_minimum ]]",
		"verified": "[[ foundry_verified ]]",
		"maximum": "[[ foundry_maximum ]]"
	},
	"authors": [
		{
			"name": "[[ author_name ]]",
			"url": "[[ author_url ]]"[% if author_discord %],
			"discord": "[[ author_discord ]]"[% endif %]
		}
	],
	"relationships": {
		"systems": [],
		"requires": []
	},[% if module_kind == 'code' %]
	"esmodules": [
		"dist/[[ module_id ]].js"
	],[% endif %][% if module_kind == 'code' and (uses_svelte or uses_styles) %]
	"styles": [
		"dist/[[ module_id ]].css"
	],[% endif %][% if localization %]
	"languages": [
		{
			"lang": "en",
			"name": "English",
			"path": "lang/en.json"
		}
	],[% endif %][% if has_packs %]
	"packs": [],[% endif %]
	"url": "https://github.com/[[ github_owner ]]/[[ repository_name ]]",
	"manifest": "https://github.com/[[ github_owner ]]/[[ repository_name ]]/releases/latest/download/module.json",
	"download": "https://github.com/[[ github_owner ]]/[[ repository_name ]]/releases/latest/download/module.zip",
	"readme": "https://github.com/[[ github_owner ]]/[[ repository_name ]]/blob/[[ default_branch ]]/README.md",
	"license": "LICENSE",
	"socket": [[ uses_socket | lower ]],
	"persistentStorage": [[ persistent_storage | lower ]],
	"media": []
}

