name: Release

on:
  push:
    tags:
      - '[[ release_tag_pattern ]]'
  workflow_dispatch:
    inputs:
      tag:
        description: Existing release tag to rebuild
        required: true
        type: string
      source_ref:
        description: Source ref to build instead of the release tag
        required: false
        type: string

run-name: Release [[ module_title ]] ${{ inputs.tag || github.ref_name }}

permissions:
  contents: write

jobs:
  release:
    runs-on: ubuntu-latest
    env:
      RELEASE_TAG: ${{ inputs.tag || github.ref_name }}
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ inputs.source_ref || inputs.tag || github.ref_name }}

      - name: Validate manual release
        if: github.event_name == 'workflow_dispatch'
        env:
          GH_TOKEN: ${{ github.token }}
        run: gh release view "$RELEASE_TAG" >/dev/null
[% if module_kind == 'code' %]
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: yarn

      - name: Enable Corepack
        run: corepack enable

      - name: Install dependencies
        run: yarn install --immutable

      - name: Verify
        run: |
[% if typecheck %]
          yarn exec tsc --noEmit
[% endif %]
          yarn lint
[% if unit_tests %]          yarn test:unit
[% endif %]
      - name: Build
        run: yarn build
[% endif %]

      - name: Prepare release manifest
        run: node tools/prepare-release.mjs module.json release/module.json "$RELEASE_TAG" "$GITHUB_SERVER_URL" "$GITHUB_REPOSITORY"

      - name: Assemble module archive
        run: |
          for artifact_path in assets dist lang packs scripts storage styles templates LICENSE README.md; do
            if [ -e "$artifact_path" ]; then
              cp -R "$artifact_path" release/
            fi
          done
          (cd release && zip -r ../module.zip .)

      - name: Create or update GitHub release
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          gh release view "$RELEASE_TAG" >/dev/null 2>&1 || gh release create "$RELEASE_TAG" --generate-notes --title "$RELEASE_TAG"
          gh release upload "$RELEASE_TAG" release/module.json module.zip --clobber
[% if publish_to_foundry %]

      - name: Register release with Foundry
        if: github.event_name == 'push'
        env:
          FVTT_TOKEN: ${{ secrets.FVTT_TOKEN }}
        run: |
          jq -n \
            --arg id "$(jq -r .id release/module.json)" \
            --arg version "$(jq -r .version release/module.json)" \
            --arg manifest "$GITHUB_SERVER_URL/$GITHUB_REPOSITORY/releases/download/$RELEASE_TAG/module.json" \
            --arg notes "$GITHUB_SERVER_URL/$GITHUB_REPOSITORY/releases/tag/$RELEASE_TAG" \
            --argjson compatibility "$(jq .compatibility release/module.json)" \
            '{id: $id, release: {version: $version, manifest: $manifest, notes: $notes, compatibility: $compatibility}}' \
            > release/foundry-payload.json
          curl --fail-with-body \
            --request POST \
            --header 'Content-Type: application/json' \
            --header "Authorization: $FVTT_TOKEN" \
            --data @release/foundry-payload.json \
            https://api.foundryvtt.com/_api/packages/release_version/
[% endif %][% if discord_notifications %]

      - name: Notify Discord
        if: github.event_name == 'push'
        env:
          WEBHOOK_URL: ${{ secrets.WEBHOOK_URL }}
        run: |
          jq -n \
            --arg content "Released [[ module_title ]] $RELEASE_TAG: $GITHUB_SERVER_URL/$GITHUB_REPOSITORY/releases/tag/$RELEASE_TAG" \
            '{content: $content}' \
            > release/discord-payload.json
          curl --fail-with-body \
            --request POST \
            --header 'Content-Type: application/json' \
            --data @release/discord-payload.json \
            "$WEBHOOK_URL"
[% endif %]
